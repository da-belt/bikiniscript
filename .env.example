# ElevenLabs API key — get yours at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_api_key_here

# SpongeBob character voice IDs from ElevenLabs Voice Library
# How to find them:
#   1. Log in to elevenlabs.io
#   2. Go to Voice Library, search each character name
#   3. Click "Add to My Voices"
#   4. Go to My Voices — copy the voice ID from each card
# You only need to fill in the characters you want; the rest are skipped.
VOICE_ID_SPONGEBOB=
VOICE_ID_PATRICK=
VOICE_ID_SANDY=
VOICE_ID_SQUIDWARD=
VOICE_ID_MRKRABS=

# Set to 1 to see TTS errors in the console
# BS_DEBUG=1
