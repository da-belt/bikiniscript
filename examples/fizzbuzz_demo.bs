// BikiniScript BubbleBass — demo
// Patrick says exactly: 1, Bubble, Bass, BubbleBass — everything else just displays

spatula bubbleBass(i) {
  aye aye (i % 15 == 0) {
    aye aye (i == 15) {
      shout("BubbleBass")
    } nay nay {
      mumble("BubbleBass")
    }
  } nay nay aye aye (i % 3 == 0) {
    aye aye (i == 3) {
      shout("Bubble")
    } nay nay {
      mumble("Bubble")
    }
  } nay nay aye aye (i % 5 == 0) {
    aye aye (i == 5) {
      shout("Bass")
    } nay nay {
      mumble("Bass")
    }
  } nay nay aye aye (i == 1) {
    shout(i)
  } nay nay {
    mumble(i)
  }
}

jellyfishing (krabby i = 1; i <= 100; i++) {
  bubbleBass(i)
}
