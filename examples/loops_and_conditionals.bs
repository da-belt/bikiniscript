// 🧽 BikiniScript — Hello, Bikini Bottom!
// Demonstrates: variables, string concat, loops

krabby message = "Hello, Bikini Bottom!"
shout(message)
shout("─────────────────────────")

jellyfishing (krabby i = 1; i <= 3; i++) {
  shout("Krabby Patty #" + i + " is ready!")
}

shout("─────────────────────────")

// Simple conditional
krabby hungry = aye
aye aye (hungry) {
  shout("I'm ready! I'm ready! Time to make patties!")
} nay nay {
  shout("Not hungry... which never happens.")
}
