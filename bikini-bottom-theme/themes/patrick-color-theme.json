  "tokenColors": [
    {
      "name": "Keywords — Patrick Pink",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#e75480", "fontStyle": "bold" }
    },
    {
      "name": "Strings — Flower Purple (shorts pattern)",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#c9a0dc" }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#9b59b6" }
    },
    {
      "name": "Numbers — Sandy Coral",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#ff9a52" }
    },
    {
      "name": "Language constants",
      "scope": ["constant.language"],
      "settings": { "foreground": "#ff7f7f", "fontStyle": "bold" }
    },
    {
      "name": "Functions — Shorts Green",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "#52b788", "fontStyle": "bold" }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#81d4aa" }
    },
    {
      "name": "Classes — Bright Pink",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "entity.name.namespace"],
      "settings": { "foreground": "#f06090", "fontStyle": "bold" }
    },
    {
      "name": "Types",
      "scope": ["support.type", "entity.name.type.interface", "entity.name.type.alias"],
      "settings": { "foreground": "#f4acbb" }
    },
    {
      "name": "Comments — Rock Brown (Patrick lives under a rock)",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7a6a50", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#fde8d8" }
    },
    {
      "name": "Properties — Peach",
      "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#ffb3a7" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#f4acbb" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation.separator", "punctuation.terminator", "punctuation.accessor", "meta.brace"],
      "settings": { "foreground": "#c49090" }
    },
    {
      "name": "HTML tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#c9a0dc", "fontStyle": "bold" }
    },
    {
      "name": "HTML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#ff9a52" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#c9a0dc" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#e75480", "fontStyle": "bold" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": { "foreground": "#ff6b6b", "fontStyle": "underline" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword":   { "foreground": "#e75480", "bold": true },
    "function":  { "foreground": "#52b788", "bold": true },
    "method":    { "foreground": "#52b788" },
    "class":     { "foreground": "#f06090", "bold": true },
    "interface": { "foreground": "#f4acbb" },
    "type":      { "foreground": "#f4acbb" },
    "variable":  { "foreground": "#fde8d8" },
    "parameter": { "foreground": "#81d4aa" },
    "property":  { "foreground": "#ffb3a7" },
    "string":    { "foreground": "#c9a0dc" },
    "number":    { "foreground": "#ff9a52" },
    "operator":  { "foreground": "#f4acbb" },
    "comment":   { "foreground": "#7a6a50", "italic": true }
  }
}
