  "tokenColors": [
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#f9d342", "fontStyle": "bold" }
    },
    {
      "name": "Control flow",
      "scope": ["keyword.control", "keyword.operator.new", "keyword.operator.delete"],
      "settings": { "foreground": "#ffeaa7", "fontStyle": "bold" }
    },
    {
      "name": "Import / export",
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.control.as"],
      "settings": { "foreground": "#f9d342", "fontStyle": "bold" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#ff7675" }
    },
    {
      "name": "String template",
      "scope": ["string.template"],
      "settings": { "foreground": "#ff9a97" }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#fd79a8" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "Language constants (true/false/null/undefined)",
      "scope": ["constant.language"],
      "settings": { "foreground": "#fd9644", "fontStyle": "bold" }
    },
    {
      "name": "Other constants",
      "scope": ["constant.other", "variable.other.constant"],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": { "foreground": "#74b9ff", "fontStyle": "bold" }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#81ecec" }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.namespace",
        "entity.name.type.class"
      ],
      "settings": { "foreground": "#fd79a8", "fontStyle": "bold" }
    },
    {
      "name": "Type annotations",
      "scope": [
        "support.type",
        "entity.name.type.interface",
        "entity.name.type.alias"
      ],
      "settings": { "foreground": "#f48fb1" }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#4a8c5c", "fontStyle": "italic" }
    },
    {
      "name": "Doc comment tags",
      "scope": ["storage.type.class.jsdoc", "punctuation.definition.block.tag.jsdoc"],
      "settings": { "foreground": "#55efc4", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#caf0f8" }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#55efc4" }
    },
    {
      "name": "Object member access",
      "scope": ["variable.other.object.property"],
      "settings": { "foreground": "#81ecec" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ffeaa7" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": { "foreground": "#7fb3cc" }
    },
    {
      "name": "Brackets and braces",
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "meta.brace",
        "punctuation.definition.array"
      ],
      "settings": { "foreground": "#7fb3cc" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#ffa94d", "fontStyle": "italic" }
    },
    {
      "name": "HTML tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#74b9ff", "fontStyle": "bold" }
    },
    {
      "name": "HTML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "HTML attribute values",
      "scope": ["string.quoted.double.html", "string.quoted.single.html"],
      "settings": { "foreground": "#ff9a97" }
    },
    {
      "name": "HTML/XML punctuation",
      "scope": [
        "punctuation.definition.tag",
        "meta.tag.sgml punctuation.definition.tag"
      ],
      "settings": { "foreground": "#4fc3f7" }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name"
      ],
      "settings": { "foreground": "#55efc4" }
    },
    {
      "name": "CSS values and units",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css",
        "keyword.other.unit.css"
      ],
      "settings": { "foreground": "#ffeaa7" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": { "foreground": "#fd79a8" }
    },
    {
      "name": "CSS at-rules",
      "scope": ["keyword.control.at-rule"],
      "settings": { "foreground": "#f9d342", "fontStyle": "bold" }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "string.quoted.double.json punctuation.support.type.property-name"
      ],
      "settings": { "foreground": "#74b9ff" }
    },
    {
      "name": "JSON values",
      "scope": ["string.quoted.double.json"],
      "settings": { "foreground": "#ff7675" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#f9d342", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ffeaa7", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#fd79a8", "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#55efc4" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#74b9ff" }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#7fb3cc", "fontStyle": "italic" }
    },
    {
      "name": "Markdown list bullet",
      "scope": ["beginning.punctuation.definition.list.markdown"],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": { "foreground": "#ff7675", "fontStyle": "underline" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#ffa94d", "fontStyle": "underline italic" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword":                  { "foreground": "#f9d342", "bold": true },
    "function":                 { "foreground": "#74b9ff", "bold": true },
    "function.declaration":     { "foreground": "#74b9ff", "bold": true },
    "method":                   { "foreground": "#74b9ff" },
    "method.declaration":       { "foreground": "#74b9ff", "bold": true },
    "class":                    { "foreground": "#fd79a8", "bold": true },
    "class.declaration":        { "foreground": "#fd79a8", "bold": true },
    "interface":                { "foreground": "#f48fb1" },
    "type":                     { "foreground": "#f48fb1" },
    "enum":                     { "foreground": "#fd79a8" },
    "enumMember":               { "foreground": "#ffa94d" },
    "namespace":                { "foreground": "#fd79a8" },
    "variable":                 { "foreground": "#caf0f8" },
    "variable.constant":        { "foreground": "#ffa94d" },
    "parameter":                { "foreground": "#81ecec" },
    "property":                 { "foreground": "#55efc4" },
    "string":                   { "foreground": "#ff7675" },
    "number":                   { "foreground": "#ffa94d" },
    "operator":                 { "foreground": "#ffeaa7" },
    "comment":                  { "foreground": "#4a8c5c", "italic": true },
    "macro":                    { "foreground": "#f9d342", "bold": true },
    "decorator":                { "foreground": "#ffa94d", "italic": true }
  }
}
