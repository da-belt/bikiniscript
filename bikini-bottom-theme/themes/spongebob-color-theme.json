  "tokenColors": [
    {
      "name": "Keywords — SpongeBob Yellow",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#f9d342", "fontStyle": "bold" }
    },
    {
      "name": "Strings — Krabby Patty Brown",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#c17f24" }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "Numbers — Sandy Orange",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "Language constants",
      "scope": ["constant.language"],
      "settings": { "foreground": "#fd9644", "fontStyle": "bold" }
    },
    {
      "name": "Functions — Ocean Blue (shirt white-blue)",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "#b0d4e8", "fontStyle": "bold" }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#81ecec" }
    },
    {
      "name": "Classes — Red (tie)",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "entity.name.namespace"],
      "settings": { "foreground": "#e53935", "fontStyle": "bold" }
    },
    {
      "name": "Types",
      "scope": ["support.type", "entity.name.type.interface", "entity.name.type.alias"],
      "settings": { "foreground": "#ef9a9a" }
    },
    {
      "name": "Comments — Sea Blue (ocean)",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#3d7a9e", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#caf0f8" }
    },
    {
      "name": "Properties — Pants Brown",
      "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#c8a96e" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ffeaa7" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation.separator", "punctuation.terminator", "punctuation.accessor", "meta.brace"],
      "settings": { "foreground": "#7fb3cc" }
    },
    {
      "name": "HTML tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#74b9ff", "fontStyle": "bold" }
    },
    {
      "name": "HTML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css"],
      "settings": { "foreground": "#b0d4e8" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#74b9ff" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#f9d342", "fontStyle": "bold" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": { "foreground": "#ff7675", "fontStyle": "underline" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword":       { "foreground": "#f9d342", "bold": true },
    "function":      { "foreground": "#b0d4e8", "bold": true },
    "method":        { "foreground": "#b0d4e8" },
    "class":         { "foreground": "#e53935", "bold": true },
    "interface":     { "foreground": "#ef9a9a" },
    "type":          { "foreground": "#ef9a9a" },
    "variable":      { "foreground": "#caf0f8" },
    "parameter":     { "foreground": "#81ecec" },
    "property":      { "foreground": "#c8a96e" },
    "string":        { "foreground": "#c17f24" },
    "number":        { "foreground": "#ffa94d" },
    "operator":      { "foreground": "#ffeaa7" },
    "comment":       { "foreground": "#3d7a9e", "italic": true }
  }
}
