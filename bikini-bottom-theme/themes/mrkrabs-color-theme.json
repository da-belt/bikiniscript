  "tokenColors": [
    {
      "name": "Keywords — Krab Red",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#e63b2e", "fontStyle": "bold" }
    },
    {
      "name": "Strings — Money Green",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#2d9e2d" }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#55efc4" }
    },
    {
      "name": "Numbers — Gold Coins",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#ffd700", "fontStyle": "bold" }
    },
    {
      "name": "Language constants",
      "scope": ["constant.language"],
      "settings": { "foreground": "#ffec6e", "fontStyle": "bold" }
    },
    {
      "name": "Functions — Light Blue Shirt",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "#87ceeb", "fontStyle": "bold" }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#b0d4e8" }
    },
    {
      "name": "Classes — Orange-Red Shell",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "entity.name.namespace"],
      "settings": { "foreground": "#ff6b35", "fontStyle": "bold" }
    },
    {
      "name": "Types",
      "scope": ["support.type", "entity.name.type.interface", "entity.name.type.alias"],
      "settings": { "foreground": "#ffaa80" }
    },
    {
      "name": "Comments — Krusty Krab Dim (old wood)",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6b5030", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#f0d8c0" }
    },
    {
      "name": "Properties — Sandy Tan",
      "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#d4a855" }
    },
    {
      "name": "Operators — Gold",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ffd700" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation.separator", "punctuation.terminator", "punctuation.accessor", "meta.brace"],
      "settings": { "foreground": "#c8a070" }
    },
    {
      "name": "HTML tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#87ceeb", "fontStyle": "bold" }
    },
    {
      "name": "HTML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#ffd700" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#87ceeb" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#ffd700", "fontStyle": "bold" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": { "foreground": "#ff4400", "fontStyle": "underline" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword":   { "foreground": "#e63b2e", "bold": true },
    "function":  { "foreground": "#87ceeb", "bold": true },
    "method":    { "foreground": "#87ceeb" },
    "class":     { "foreground": "#ff6b35", "bold": true },
    "interface": { "foreground": "#ffaa80" },
    "type":      { "foreground": "#ffaa80" },
    "variable":  { "foreground": "#f0d8c0" },
    "parameter": { "foreground": "#b0d4e8" },
    "property":  { "foreground": "#d4a855" },
    "string":    { "foreground": "#2d9e2d" },
    "number":    { "foreground": "#ffd700", "bold": true },
    "operator":  { "foreground": "#ffd700" },
    "comment":   { "foreground": "#6b5030", "italic": true }
  }
}
