  "tokenColors": [
    {
      "name": "Keywords — Squidward Teal",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#40e0d0", "fontStyle": "bold" }
    },
    {
      "name": "Strings — Clarinet Purple (his beloved clarinet)",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#9b59b6" }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#c39bd3" }
    },
    {
      "name": "Numbers — Easter Island Tan (his house)",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#c4a882" }
    },
    {
      "name": "Language constants",
      "scope": ["constant.language"],
      "settings": { "foreground": "#d4b896", "fontStyle": "bold" }
    },
    {
      "name": "Functions — Painting Beige (his art)",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
      "settings": { "foreground": "#e2c9a0", "fontStyle": "bold" }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#b2e8e0" }
    },
    {
      "name": "Classes — Bright Teal",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "entity.name.namespace"],
      "settings": { "foreground": "#5aeae0", "fontStyle": "bold" }
    },
    {
      "name": "Types",
      "scope": ["support.type", "entity.name.type.interface", "entity.name.type.alias"],
      "settings": { "foreground": "#81ecec" }
    },
    {
      "name": "Comments — Moody Dark (Squidward's grumpy attitude)",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#334455", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#c8e8e4" }
    },
    {
      "name": "Properties — Light Teal",
      "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#7ad4cc" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#81ecec" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation.separator", "punctuation.terminator", "punctuation.accessor", "meta.brace"],
      "settings": { "foreground": "#7ab0b0" }
    },
    {
      "name": "HTML tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#40e0d0", "fontStyle": "bold" }
    },
    {
      "name": "HTML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#c4a882" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#5aeae0" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#40e0d0", "fontStyle": "bold" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": { "foreground": "#ff7675", "fontStyle": "underline" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword":   { "foreground": "#40e0d0", "bold": true },
    "function":  { "foreground": "#e2c9a0", "bold": true },
    "method":    { "foreground": "#e2c9a0" },
    "class":     { "foreground": "#5aeae0", "bold": true },
    "interface": { "foreground": "#81ecec" },
    "type":      { "foreground": "#81ecec" },
    "variable":  { "foreground": "#c8e8e4" },
    "parameter": { "foreground": "#b2e8e0" },
    "property":  { "foreground": "#7ad4cc" },
    "string":    { "foreground": "#9b59b6" },
    "number":    { "foreground": "#c4a882" },
    "operator":  { "foreground": "#81ecec" },
    "comment":   { "foreground": "#334455", "italic": true }
  }
}
